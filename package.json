{
  "name": "@a11ypilot/cli",
  "version": "0.1.0",
  "description": "Keyboard journey accessibility evidence CLI",
  "type": "module",
  "bin": {
    "a11ypilot": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:cli && npm run build:ui",
    "build:cli": "tsc -p tsconfig.json",
    "build:ui": "tsc -p tsconfig.app.json && vite build",
    "typecheck": "npm run typecheck:cli && npm run typecheck:ui",
    "typecheck:cli": "tsc --noEmit -p tsconfig.json",
    "typecheck:ui": "tsc --noEmit -p tsconfig.app.json",
    "lint": "prettier --check src tests",
    "test": "vitest run tests/unit",
    "test:ui": "vitest run src/App.test.tsx",
    "test:e2e": "npm run build:cli && npm run build:ui && node scripts/run-e2e.mjs",
    "test:all": "npm test && npm run test:ui && npm run test:e2e",
    "playwright:install": "playwright install chromium",
    "format": "prettier --write src tests",
    "dev": "vite",
    "preview": "vite preview --outDir dist-ui",
    "validate:journey": "node dist/src/cli.js validate",
    "run:journey": "node dist/src/cli.js run",
    "docker:check": "docker build -t a11ypilot:local ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "commander": "^12.1.0",
    "gsap": "^3.12.5",
    "playwright": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.10",
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.7.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.12.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
